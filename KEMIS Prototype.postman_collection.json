        {
          "name": "Get Schools by County",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status code is 200\", function () {\n    pm.response.to.have.status(200);\n});\n\npm.test(\"Response time is less than 7000ms\", function () {\n    pm.expect(pm.response.responseTime).to.be.below(7000);\n});\n\npm.test(\"Response body has correct structure\", function () {\n    const jsonData = pm.response.json();\n    pm.expect(jsonData).to.have.property(\"county\", \"Alameda\");\n    pm.expect(jsonData).to.have.property(\"schools\").that.is.an(\"array\");\n});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "http://localhost:5215/api/county-education/institutions?county=Nairobi",
              "protocol": "http",
              "host": [
                "localhost"
              ],
              "port": "5215",
              "path": [
                "api",
                "county-education",
                "institutions"
